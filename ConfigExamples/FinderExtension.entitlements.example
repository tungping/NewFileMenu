<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Finder Sync extensions must be sandboxed to be enabled by macOS. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Non-App-Store/self-use exception: allow writes in the user's home directory. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<!-- Non-App-Store/self-use exception: allow writes on external volumes. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/Volumes/</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tungping.NewTextFile</string>
	</array>
</dict>
</plist>
